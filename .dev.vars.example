# Copy to .dev.vars. Cloudflare Access is simulated by the `access.dev` block
# in wrangler.jsonc rather than by anything here.

# The AI Gateway the models are reached through, which decides how inference is
# billed and rate limited. Empty leaves the account's default gateway to answer.
# A deployment answers this with a secret instead, so wrangler.jsonc declares
# nothing and env.d.ts is what types the binding.
AI_GATEWAY=

# Whether a generated file is copied into the bucket as well as linked. Only
# `yes` turns it on; anything else, this one empty included, leaves it off.
BACKUP=

# What signs the link a reply hands on to a copy: the account, an R2 API token
# able to read the bucket, and the bucket's name as the R2 page shows it —
# usually <Worker name>-bucket. Any of them empty leaves the copying off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# The time zone the date in a backup's path is read in, as an IANA name such as
# Asia/Taipei. Empty reads it in UTC.
TZ=
