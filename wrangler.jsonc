/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "creator-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	/**
	 * Cloudflare Access guards the hostname this Worker is routed to. A
	 * workers.dev subdomain would be a second origin outside that guard, so
	 * there is none.
	 */
	"workers_dev": false,
	/**
	 * DEBUG lifts the Access requirement so the MCP endpoint can be driven
	 * locally, where no Access sits in front. It is false wherever this file
	 * is deployed; only a local .dev.vars turns it on.
	 */
	"vars": {
		"DEBUG": "false",
	},
	/**
	 * The Access team name and application audience tag, which is what
	 * `cloudflareAccess()` asks for. Declaring them here
	 * rather than letting them be inferred from .dev.vars keeps the generated
	 * types the same for everyone, since .dev.vars is never committed; keeping
	 * them out of `vars` keeps a deploy from overwriting what is set on the
	 * Worker.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"secrets": {
		"required": ["TEAM_NAME", "POLICY_AUD"],
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
