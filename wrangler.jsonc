/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "creator-kit",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	/**
	 * Every step this Worker takes is a wait on something else, so an
	 * invocation record is where a failure becomes visible at all. A trace is
	 * what says which of those waits was the slow one — logs alone cannot, since
	 * they carry no span. Traces bill at the logs rate from 2026-10-01, and that
	 * is what the answer costs.
	 * https://developers.cloudflare.com/workers/observability/traces/
	 */
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
		},
	},
	"upload_source_maps": true,
	/**
	 * Cloudflare Access is attached to this Worker rather than to a hostname,
	 * so it already covers every route, Custom Domain, preview and the
	 * workers.dev subdomain. That subdomain stays open because `wrangler dev`
	 * identifies the Access application by it: closed, it answers Error 1042
	 * before Access can, `cloudflared` finds no application at that address,
	 * and every remote binding a local session reaches for comes back 401 with
	 * nothing said about why. Nothing else needs the second address, and Access
	 * covers it either way.
	 *
	 * A worker-level policy does not carry WebSocket: an upgrade request is
	 * answered 403. The MCP endpoint speaks Streamable HTTP, so none is asked
	 * for here.
	 * https://developers.cloudflare.com/workers/configuration/cloudflare-access/
	 */
	"workers_dev": true,
	/**
	 * No Access stands in front of `wrangler dev`, so this stands in for one:
	 * every local request arrives already matched, carrying this identity.
	 * Removing the block is what drives the unmatched path by hand; the test
	 * suite decides it per request instead. Nothing reads `aud`, so the real
	 * application's tag never has to be written down here.
	 * https://developers.cloudflare.com/workers/configuration/cloudflare-access/
	 */
	"access": {
		"dev": {
			"aud": "local-dev",
			"identity": {
				"email": "developer@example.com",
			},
		},
	},
	/**
	 * Workers AI runs the image model the MCP endpoint offers. This binding
	 * has no local simulation: every call reaches the account and is billed,
	 * `wrangler dev` included, which is why the test suite closes remote
	 * bindings off rather than holding one of these.
	 * https://developers.cloudflare.com/workers/development-testing/bindings-per-env/
	 *
	 * AI_GATEWAY names the gateway those calls are reached through, which is
	 * what decides how they are billed and rate limited. It is deliberately
	 * absent from this file: a deployment answers with a secret, and a var of
	 * the same name is uploaded over that secret on every deploy, leaving the
	 * account's default gateway to answer. `.dev.vars` is what names one
	 * locally, and it reaches `wrangler dev` without being declared here —
	 * declaring it is precisely what would undo this.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"ai": {
		"binding": "AI",
	},
	/**
	 * Where a deployment keeps what it backs up. No `bucket_name` stands here,
	 * which is what has the first deploy create the bucket and keep every later
	 * deploy pointed at the same one — a name written down instead would be one
	 * more thing to create by hand before deploying, and one deployment's answer
	 * living in the repository.
	 *
	 * The binding is declared here rather than added in the dashboard for the
	 * reason a secret is not declared here: a deploy uploads this file over what
	 * the dashboard holds. The bucket is not named for backups either —
	 * `backup/` is one prefix inside it, so whatever else it comes to hold can
	 * still say what it is.
	 * https://developers.cloudflare.com/changelog/post/2025-10-24-automatic-resource-provisioning/
	 */
	"r2_buckets": [
		{
			"binding": "BUCKET",
		},
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
