{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/edit.sh\"",
						"timeout": 120,
						"statusMessage": "Formatting and type check"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop.sh\"",
						"timeout": 300,
						"statusMessage": "Tests, specification and types"
					}
				]
			}
		]
	}
}
